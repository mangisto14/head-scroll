<body>

<div class="card">
  <div id="up-arrow" class="nav">▲ Tilt Up = Prev</div>
  <div class="word" id="word">—</div>
  <div class="hint">Tilt head to navigate cards</div>
  <div id="down-arrow" class="nav">▼ Tilt Down = Next</div>
  <div class="status" id="status">Starting…</div>
  <button onclick="hs.calibrate()">⚙ Recalibrate</button>
</div>

<script src="../head-scroll.js"></script>
<script>
  const words = ['Apple', 'Bridge', 'Castle', 'Dragon', 'Eclipse',
                 'Forest', 'Guitar', 'Harbor', 'Island', 'Jungle'];
  let idx = 0;

  const wordEl   = document.getElementById('word');
  const statusEl = document.getElementById('status');
  const upEl     = document.getElementById('up-arrow');
  const downEl   = document.getElementById('down-arrow');

  function showWord(i) {
    idx = Math.max(0, Math.min(words.length - 1, i));
    wordEl.textContent = words[idx];
  }

  let lastDir = 'none';

  const hs = new HeadScroll({
    showHUD: false,   // no built-in HUD, we handle it ourselves

    onStatus: (type, msg) => {
      statusEl.textContent = msg;
    },

    onCalibrated: () => {
      statusEl.textContent = 'Ready — tilt to navigate';
      showWord(0);
    },

    onFrame: ({ scrolling }) => {
      upEl.classList.toggle('active', scrolling === 'up');
      downEl.classList.toggle('active', scrolling === 'down');

      // Trigger on direction change only (not every frame)
      if (scrolling !== lastDir) {
        if (scrolling === 'down') showWord(idx + 1);
        if (scrolling === 'up')   showWord(idx - 1);
        lastDir = scrolling;
      }
    },
  });

  hs.start();
</script>
</body>
