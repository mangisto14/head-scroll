  }
  .word {
    font-size: 48px; font-weight: 700; color: #fff; margin: 24px 0;
    min-height: 64px;
    transition: opacity 0.15s;
  }
  .hint { font-size: 13px; color: #888; margin-top: 8px; }
  .status {
    font-size: 11px; color: #666; font-family: monospace;
    margin-top: 20px; min-height: 16px;
  }
  .nav { font-size: 28px; opacity: 0.2; transition: opacity 0.1s; }
  .nav.active { opacity: 1; }
  #up-arrow { color: #00f5ff; }
  #down-arrow { color: #ff3355; }
  button {
    background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15);
